# Pages must always be rechecked so a deploy shows up at once; CSS, JS and images
# carry ?v=<content hash> links (tools/version-assets.py), so they can stay cached.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Versioned files never change under the same URL, so browsers may keep them for a year
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|avif|webp|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
